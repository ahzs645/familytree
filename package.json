{
  "name": "cloudtreeweb-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-local family tree application (CloudTreeWeb)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "copy-wasm": "cp node_modules/sql.js/dist/sql-wasm.js public/ && cp node_modules/sql.js/dist/sql-wasm.wasm public/",
    "sync:mft-models": "node scripts/sync-mft-model-assets.mjs",
    "extract": "node scripts/extract-mftpkg.js",
    "prepare:assets": "npm run copy-wasm",
    "parity": "node scripts/validate-mft-parity.mjs",
    "parity:update": "node scripts/validate-mft-parity.mjs --update"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "^5.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "relatives-tree": "^3.2.2",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@firstform/json-url": "file:./vendor/json-url",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.9.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.4"
  }
}
